<!-- src/mail/templates/password-reset-confirmation.hbs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Reset Confirmation</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            line-height: 1.6;
            color: #333333;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            padding: 0;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .header {
            background-color: #16a34a;
            color: white;
            padding: 30px;
            text-align: center;
            border-radius: 8px 8px 0 0;
        }
        .header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: bold;
        }
        .content {
            padding: 40px 30px;
        }
        .content h2 {
            color: #16a34a;
            margin-bottom: 20px;
        }
        .button {
            display: inline-block;
            background-color: #2563eb;
            color: white;
            padding: 12px 30px;
            text-decoration: none;
            border-radius: 6px;
            font-weight: bold;
            margin: 20px 0;
            text-align: center;
        }
        .button:hover {
            background-color: #1d4ed8;
        }
        .success-box {
            background-color: #f0fdf4;
            border-left: 4px solid #16a34a;
            padding: 20px;
            margin: 20px 0;
            border-radius: 0 6px 6px 0;
        }
        .footer {
            background-color: #f8fafc;
            padding: 20px 30px;
            text-align: center;
            border-top: 1px solid #e5e7eb;
            border-radius: 0 0 8px 8px;
            font-size: 14px;
            color: #6b7280;
        }
        .info-box {
            background-color: #f0f9ff;
            border-left: 4px solid #2563eb;
            padding: 20px;
            margin: 20px 0;
        }
        .details-table {
            width: 100%;
            border-collapse: collapse;
            margin: 15px 0;
        }
        .details-table th,
        .details-table td {
            padding: 10px;
            text-align: left;
            border-bottom: 1px solid #e5e7eb;
        }
        .details-table th {
            background-color: #f8fafc;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>✅ Password Reset Complete</h1>
            <p>Your password has been successfully reset</p>
        </div>
        
        <div class="content">
            <h2>Hello {{user.username}},</h2>
            
            <div class="success-box">
                <h3>🔐 Password Reset Successful</h3>
                <p>Your TPG State Portal password has been successfully reset and updated. You can now log in with your new password.</p>
            </div>
            
            <p>This email confirms that your password reset process was completed successfully on {{timestamp}}.</p>
            
            <div class="info-box">
                <h3>Reset Details:</h3>
                <table class="details-table">
                    <tr>
                        <th>Account:</th>
                        <td>{{user.email}}</td>
                    </tr>
                    <tr>
                        <th>Reset Completed:</th>
                        <td>{{timestamp}}</td>
                    </tr>
                    {{#if ipAddress}}
                    <tr>
                        <th>IP Address:</th>
                        <td>{{ipAddress}}</td>
                    </tr>
                    {{/if}}
                    {{#if userAgent}}
                    <tr>
                        <th>Device/Browser:</th>
                        <td>{{userAgent}}</td>
                    </tr>
                    {{/if}}
                </table>
            </div>
            
            <h3>What Happens Next:</h3>
            <ul>
                <li>Your new password is now active and ready to use</li>
                <li>All previous login sessions have been invalidated for security</li>
                <li>You'll need to log in again on all your devices</li>
                <li>Update any saved passwords in your browser or password manager</li>
            </ul>
            
            <div style="text-align: center;">
                <a href="{{loginUrl}}" class="button">Log In to Your Account</a>
            </div>
            
            <h3>🛡️ Security Recommendations:</h3>
            <ul>
                <li><strong>Strong Password:</strong> Ensure your new password is unique and complex</li>
                <li><strong>Password Manager:</strong> Consider using a password manager for secure storage</li>
                <li><strong>Regular Updates:</strong> Change your password periodically</li>
                <li><strong>Two-Factor Authentication:</strong> Enable 2FA for additional security</li>
                <li><strong>Monitor Activity:</strong> Regularly review your account activity</li>
            </ul>
            
            <h3>Account Security:</h3>
            <p>Your TPG account contains sensitive professional information including:</p>
            <ul>
                <li>Pharmacy license and registration details</li>
                <li>CPD (Continuing Professional Development) records</li>
                <li>Payment and subscription information</li>
                <li>Support tickets and communication history</li>
            </ul>
            
            <p>If you didn't initiate this password reset or have any concerns about your account security, please contact our support team immediately.</p>
            
            <h3>Need Help?</h3>
            <p>If you have any questions or need assistance logging in with your new password, please contact our support team at <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>.</p>
            
            <p><strong>Support Reference:</strong> PWD-RESET-{{user.id}}-{{timestamp}}</p>
        </div>
        
        <div class="footer">
            <p>This password reset confirmation was sent to {{user.email}} on {{timestamp}}.</p>
            <p>This is an automated notification from {{companyName}}.</p>
            <p>&copy; {{year}} {{companyName}}. All rights reserved.</p>
        </div>
    </div>
</body>
</html>