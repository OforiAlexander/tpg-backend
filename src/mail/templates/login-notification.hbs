<!-- src/mail/templates/login-notification.hbs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Login to Your TPG Account</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            line-height: 1.6;
            color: #333333;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            padding: 0;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .header {
            background-color: #10b981;
            color: white;
            padding: 30px;
            text-align: center;
            border-radius: 8px 8px 0 0;
        }
        .header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: bold;
        }
        .content {
            padding: 40px 30px;
        }
        .content h2 {
            color: #10b981;
            margin-bottom: 20px;
        }
        .button {
            display: inline-block;
            background-color: #2563eb;
            color: white;
            padding: 12px 30px;
            text-decoration: none;
            border-radius: 6px;
            font-weight: bold;
            margin: 20px 0;
            text-align: center;
        }
        .button:hover {
            background-color: #1d4ed8;
        }
        .info-box {
            background-color: #f0fdf4;
            border-left: 4px solid #10b981;
            padding: 20px;
            margin: 20px 0;
            border-radius: 0 6px 6px 0;
        }
        .footer {
            background-color: #f8fafc;
            padding: 20px 30px;
            text-align: center;
            border-top: 1px solid #e5e7eb;
            border-radius: 0 0 8px 8px;
            font-size: 14px;
            color: #6b7280;
        }
        .notice {
            background-color: #fffbeb;
            border-left: 4px solid #f59e0b;
            padding: 15px;
            margin: 20px 0;
            font-size: 14px;
        }
        .details-table {
            width: 100%;
            border-collapse: collapse;
            margin: 15px 0;
        }
        .details-table th,
        .details-table td {
            padding: 10px;
            text-align: left;
            border-bottom: 1px solid #e5e7eb;
        }
        .details-table th {
            background-color: #f8fafc;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🔐 Login Notification</h1>
            <p>New sign-in to your TPG account</p>
        </div>
        
        <div class="content">
            <h2>Hello {{user.username}},</h2>
            
            <p>We're writing to let you know that someone {{#if loginDetails.isNewDevice}}(hopefully you){{/if}} just signed into your TPG State Portal account{{#if loginDetails.isNewDevice}} from a new device{{/if}}{{#if loginDetails.isNewLocation}} from a new location{{/if}}.</p>
            
            <div class="info-box">
                <h3>Login Details:</h3>
                <table class="details-table">
                    <tr>
                        <th>Time:</th>
                        <td>{{loginDetails.timestamp}}</td>
                    </tr>
                    {{#if loginDetails.location}}
                    <tr>
                        <th>Location:</th>
                        <td>{{loginDetails.location}}</td>
                    </tr>
                    {{/if}}
                    {{#if loginDetails.ipAddress}}
                    <tr>
                        <th>IP Address:</th>
                        <td>{{loginDetails.ipAddress}}</td>
                    </tr>
                    {{/if}}
                    {{#if loginDetails.userAgent}}
                    <tr>
                        <th>Device/Browser:</th>
                        <td>{{loginDetails.userAgent}}</td>
                    </tr>
                    {{/if}}
                </table>
            </div>
            
            {{#if loginDetails.isNewDevice}}
            <div class="notice">
                <h3>🆕 New Device Detected</h3>
                <p>This login was from a device we haven't seen before. If this was you logging in from a new computer, phone, or tablet, no action is needed.</p>
            </div>
            {{/if}}
            
            {{#if loginDetails.isNewLocation}}
            <div class="notice">
                <h3>📍 New Location Detected</h3>
                <p>This login was from a location that's different from your usual sign-in pattern. If you're traveling, using a VPN, or accessing from a new location, this is expected.</p>
            </div>
            {{/if}}
            
            <h3>Was This You?</h3>
            <p><strong>If you just signed in:</strong> Great! You can ignore this email. This is just a security notification to keep you informed about account activity.</p>
            
            <p><strong>If this wasn't you:</strong> Someone else may have access to your account. Please secure your account immediately:</p>
            
            <ul>
                <li>Change your password right away</li>
                <li>Review your account settings and recent activity</li>
                <li>Check that your contact information is correct</li>
                <li>Enable two-factor authentication if available</li>
                <li>Log out of all devices and sign back in</li>
            </ul>
            
            <div style="text-align: center;">
                <a href="{{securityUrl}}" class="button">Review Security Settings</a>
            </div>
            
            <h3>🔒 Security Tips:</h3>
            <ul>
                <li>Always log out when using shared or public computers</li>
                <li>Use a strong, unique password for your TPG account</li>
                <li>Keep your browser and security software up to date</li>
                <li>Be cautious of phishing emails asking for your login details</li>
                <li>Never share your TPG account credentials with anyone</li>
            </ul>
            
            <h3>Account Security</h3>
            <p>Your TPG account contains sensitive information including your pharmacy license details, CPD points, and professional information. We monitor login activity to help protect your account from unauthorized access.</p>
            
            <h3>Need Help?</h3>
            <p>If you have questions about this login or need help securing your account, please contact our support team at <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>.</p>
        </div>
        
        <div class="footer">
            <p>This login notification was sent to {{user.email}} for a login at {{loginDetails.timestamp}}.</p>
            <p>This is an automated security notification from {{companyName}}.</p>
            <p>&copy; {{year}} {{companyName}}. All rights reserved.</p>
        </div>
    </div>
</body>
</html>