<!-- src/mail/templates/welcome.hbs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to TPG Portal</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            line-height: 1.6;
            color: #333333;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            padding: 0;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .header {
            background-color: #2563eb;
            color: white;
            padding: 30px;
            text-align: center;
            border-radius: 8px 8px 0 0;
        }
        .header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: bold;
        }
        .content {
            padding: 40px 30px;
        }
        .content h2 {
            color: #2563eb;
            margin-bottom: 20px;
        }
        .button {
            display: inline-block;
            background-color: #16a34a;
            color: white;
            padding: 12px 30px;
            text-decoration: none;
            border-radius: 6px;
            font-weight: bold;
            margin: 20px 0;
            text-align: center;
        }
        .button:hover {
            background-color: #15803d;
        }
        .info-box {
            background-color: #f8fafc;
            border-left: 4px solid #2563eb;
            padding: 20px;
            margin: 20px 0;
        }
        .footer {
            background-color: #f8fafc;
            padding: 20px 30px;
            text-align: center;
            border-top: 1px solid #e5e7eb;
            border-radius: 0 0 8px 8px;
            font-size: 14px;
            color: #6b7280;
        }
        .warning {
            background-color: #fef3c7;
            border-left: 4px solid #f59e0b;
            padding: 15px;
            margin: 20px 0;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Welcome to {{companyName}}</h1>
            <p>University of Professional Studies, Accra</p>
        </div>
        
        <div class="content">
            <h2>Welcome, {{user.username}}!</h2>
            
            <p>Thank you for registering with the U (TPG) State Portal. Your account has been created successfully and you're one step away from accessing all our services.</p>
            
            <div class="info-box">
                <h3>Your Account Details:</h3>
                <ul>
                    <li><strong>Username:</strong> {{user.username}}</li>
                    <li><strong>Email:</strong> {{user.email}}</li>
                    <li><strong>TPG License:</strong> {{#if user.tpg_license_number}}{{user.tpg_license_number}}{{else}}Not provided{{/if}}</li>
                    <li><strong>Pharmacy:</strong> {{#if user.pharmacy_name}}{{user.pharmacy_name}}{{else}}Not provided{{/if}}</li>
                </ul>
            </div>
            
            <h3>Next Step: Verify Your Email</h3>
            <p>To complete your registration and secure your account, please verify your email address by clicking the button below:</p>
            
            <div style="text-align: center;">
                <a href="{{verificationUrl}}" class="button">Verify Email Address</a>
            </div>
            
            <div class="warning">
                <strong>Important:</strong> This verification link will expire in 24 hours. If you don't verify your email within this time, you'll need to request a new verification link.
            </div>
            
            <h3>What's Next?</h3>
            <p>Once your email is verified, you'll be able to:</p>
            <ul>
                <li>Submit and track support tickets</li>
                <li>Manage your TPG license information</li>
                <li>Access CPD points tracking</li>
                <li>View payment and licensing status</li>
                <li>Receive important notifications</li>
            </ul>
            
            <h3>Need Help?</h3>
            <p>If you have any questions or need assistance, please don't hesitate to contact our support team at <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>.</p>
        </div>
        
        <div class="footer">
            <p>This email was sent to {{user.email}} on {{timestamp}}.</p>
            <p>If you didn't create this account, please ignore this email or contact support.</p>
            <p>&copy; {{year}} {{companyName}}. All rights reserved.</p>
        </div>
    </div>
</body>
</html>