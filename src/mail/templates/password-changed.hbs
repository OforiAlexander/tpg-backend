<!-- src/mail/templates/password-changed.hbs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Changed Successfully</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            line-height: 1.6;
            color: #333333;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            padding: 0;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .header {
            background-color: #16a34a;
            color: white;
            padding: 30px;
            text-align: center;
            border-radius: 8px 8px 0 0;
        }
        .header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: bold;
        }
        .content {
            padding: 40px 30px;
        }
        .content h2 {
            color: #16a34a;
            margin-bottom: 20px;
        }
        .button {
            display: inline-block;
            background-color: #2563eb;
            color: white;
            padding: 12px 30px;
            text-decoration: none;
            border-radius: 6px;
            font-weight: bold;
            margin: 20px 0;
            text-align: center;
        }
        .button:hover {
            background-color: #1d4ed8;
        }
        .success-box {
            background-color: #f0fdf4;
            border-left: 4px solid #16a34a;
            padding: 20px;
            margin: 20px 0;
            border-radius: 0 6px 6px 0;
        }
        .footer {
            background-color: #f8fafc;
            padding: 20px 30px;
            text-align: center;
            border-top: 1px solid #e5e7eb;
            border-radius: 0 0 8px 8px;
            font-size: 14px;
            color: #6b7280;
        }
        .warning {
            background-color: #fef3c7;
            border-left: 4px solid #f59e0b;
            padding: 15px;
            margin: 20px 0;
            font-size: 14px;
        }
        .details-table {
            width: 100%;
            border-collapse: collapse;
            margin: 15px 0;
        }
        .details-table th,
        .details-table td {
            padding: 10px;
            text-align: left;
            border-bottom: 1px solid #e5e7eb;
        }
        .details-table th {
            background-color: #f8fafc;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>✅ Password Changed</h1>
            <p>Your password has been updated successfully</p>
        </div>
        
        <div class="content">
            <h2>Hello {{user.username}},</h2>
            
            <div class="success-box">
                <h3>🔐 Password Updated Successfully</h3>
                <p>Your TPG State Portal password has been changed successfully. Your account is now secured with the new password.</p>
            </div>
            
            <p>This email confirms that your account password was changed on {{timestamp}}. If you made this change, no further action is required.</p>
            
            <h3>Change Details:</h3>
            <table class="details-table">
                <tr>
                    <th>Account:</th>
                    <td>{{user.email}}</td>
                </tr>
                <tr>
                    <th>Changed At:</th>
                    <td>{{timestamp}}</td>
                </tr>
                {{#if ipAddress}}
                <tr>
                    <th>IP Address:</th>
                    <td>{{ipAddress}}</td>
                </tr>
                {{/if}}
                {{#if userAgent}}
                <tr>
                    <th>Device/Browser:</th>
                    <td>{{userAgent}}</td>
                </tr>
                {{/if}}
            </table>
            
            <h3>Important Security Information:</h3>
            <ul>
                <li>You'll need to use your new password for all future logins</li>
                <li>All existing login sessions have been invalidated for security</li>
                <li>You may need to sign in again on all your devices</li>
                <li>Make sure to update any saved passwords in your browser or password manager</li>
            </ul>
            
            <div class="warning">
                <h3>⚠️ Didn't Change Your Password?</h3>
                <p><strong>If you didn't make this change:</strong> Someone else may have accessed your account. Please take immediate action:</p>
                <ul>
                    <li>Try to log in with your old password (it may still work briefly)</li>
                    <li>If you can't access your account, use the password reset feature</li>
                    <li>Contact support immediately for assistance</li>
                    <li>Review your account for any unauthorized changes</li>
                    <li>Check your pharmacy and license information for tampering</li>
                </ul>
            </div>
            
            <h3>🔒 Additional Security Recommendations:</h3>
            <ul>
                <li><strong>Password Strength:</strong> Ensure your new password is strong and unique</li>
                <li><strong>Two-Factor Authentication:</strong> Consider enabling 2FA for extra security</li>
                <li><strong>Regular Updates:</strong> Change your password periodically</li>
                <li><strong>Secure Storage:</strong> Use a password manager to store your credentials safely</li>
                <li><strong>Phishing Awareness:</strong> Be cautious of emails asking for your login details</li>
            </ul>
            
            <h3>What's Protected:</h3>
            <p>Your TPG account secures important information including:</p>
            <ul>
                <li>Pharmacy license and registration details</li>
                <li>CPD (Continuing Professional Development) points and records</li>
                <li>Payment and subscription information</li>
                <li>Support tickets and communication history</li>
                <li>Professional profile and contact information</li>
            </ul>
            
            <div style="text-align: center;">
                <a href="{{securityUrl}}" class="button">Review Security Settings</a>
            </div>
            
            <h3>Need Help?</h3>
            <p>If you have questions about this password change or need assistance with your account security, please contact our support team at <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>.</p>
            
            <p><strong>Support Reference:</strong> PWD-{{user.id}}-{{timestamp}}</p>
        </div>
        
        <div class="footer">
            <p>This password change notification was sent to {{user.email}} on {{timestamp}}.</p>
            <p>This is an automated security notification from {{companyName}}.</p>
            <p>&copy; {{year}} {{companyName}}. All rights reserved.</p>
        </div>
    </div>
</body>
</html>